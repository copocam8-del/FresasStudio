# Copiar a .env.local y completar. .env.local no se sube a git.
#
# URL del proyecto: Supabase > Project Settings > Data API (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Clave publishable (sb_publishable_...): Supabase > Project Settings > API Keys.
# Es pública y va al navegador; la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dominio raíz de la plataforma: los estudios viven en {slug}.<dominio raíz>.
# Desarrollo: localhost:3000 (fresas.localhost:3000, admin.localhost:3000…)
# Producción: cleo.com.ar
NEXT_PUBLIC_ROOT_DOMAIN=

# La clave secret / service_role NO va en este archivo con prefijo NEXT_PUBLIC_ ni en
# ningún código del frontend. Si en el futuro hace falta en el servidor, se agrega como
# variable sin prefijo (p. ej. SUPABASE_SECRET_KEY) y solo se lee en módulos "server-only".

# SOLO DESARROLLO: muestra "Simular pago aprobado" en la reserva. Necesita además la
# función dev_simulate_deposit_payment, que solo crea el seed (en producción no existe).
# En producción: no definir o "false".
NEXT_PUBLIC_ENABLE_SIMULATED_PAYMENTS=false

# ---------------------------------------------------------------------------
# Mercado Pago y pagos (Sprint 5). TODAS solo de servidor: sin prefijo NEXT_PUBLIC_.
# En producción se cargan en el Web Service de Render (Environment). Nunca en el repo.
# Si falta alguna, Mercado Pago queda "no disponible" y el panel lo explica.
# ---------------------------------------------------------------------------
# Mercado Pago Developers > Tus integraciones > (la aplicación) > Credenciales
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# La URL de redireccionamiento registrada en la aplicación (coincide EXACTO).
# Producción: https://cleo.com.ar/api/pagos/mp/vuelta · Desarrollo: la del túnel.
MP_OAUTH_REDIRECT_URI=
# Webhooks > Configurar notificaciones > clave secreta (firma de los avisos)
MP_WEBHOOK_SECRET=
# Clave para cifrar los tokens de Mercado Pago: 32 bytes en base64, DISTINTA en cada entorno.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENTS_ENCRYPTION_KEY=
# Rotación (opcional): subir la versión y dejar la anterior en _PREVIOUS hasta re-cifrar.
PAYMENTS_ENCRYPTION_KEY_VERSION=1
# PAYMENTS_ENCRYPTION_KEY_PREVIOUS=
# Supabase > Project Settings > API Keys > secret (sb_secret_...). Solo para las funciones svc_mp_*.
SUPABASE_SECRET_KEY=
# Protege /api/pagos/interno/* (lo llama pg_cron cada 10 min). 32+ caracteres aleatorios.
CRON_SECRET=
# SOLO e2e: Mercado Pago simulado en la propia máquina (se ignora si no es localhost).
# MP_API_BASE_URL=http://localhost:4010
# MP_AUTH_BASE_URL=http://localhost:4010
